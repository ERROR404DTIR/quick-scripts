#!/usr/bin/env sh
# Usage: killport PORT  - kill whatever is listening on a TCP port
[ -n "$1" ] || { echo "usage: killport PORT" >&2; exit 1; }
pids=$(lsof -ti tcp:"$1" 2>/dev/null || true)
[ -n "$pids" ] || { echo "nothing on port $1"; exit 0; }
echo "$pids" | xargs kill -9 && echo "killed: $pids"
